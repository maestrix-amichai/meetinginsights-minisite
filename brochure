<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meeting Insights - Enterprise Brochure</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            color: #1a1a2e;
            line-height: 1.6;
            background: #f0f4f8;
        }
        
        .brochure-container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        }
        
        /* Header */
        .header {
            background: linear-gradient(135deg, #0066CC 0%, #004499 100%);
            color: white;
            padding: 30px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo-section {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .logo {
            width: 50px;
            height: 50px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #0066CC;
            font-size: 20px;
        }
        
        .brand-name {
            font-size: 24px;
            font-weight: 300;
        }
        
        .tagline {
            font-size: 14px;
            opacity: 0.9;
        }
        
        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, #0066CC 0%, #004499 100%);
            color: white;
            padding: 80px 60px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }
        
        .hero h1 {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }
        
        .hero-subtitle {
            font-size: 20px;
            margin-bottom: 40px;
            opacity: 0.95;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            position: relative;
            z-index: 1;
        }
        
        .hero-badges {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }
        
        .badge {
            background: rgba(255,255,255,0.2);
            padding: 10px 20px;
            border-radius: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
        }
        
        /* Problem Section */
        .problem-section {
            padding: 80px 60px;
            background: linear-gradient(180deg, #ffffff 0%, #f8f9fb 100%);
        }
        
        .section-title {
            font-size: 36px;
            font-weight: 700;
            color: #1a1a2e;
            text-align: center;
            margin-bottom: 20px;
        }
        
        .problem-cards {
            display: flex;
            gap: 30px;
            overflow-x: auto;
            padding-bottom: 20px;
        }
        
        .problem-card {
            min-width: 400px;
            background: white;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border: 1px solid #e0e0e0;
        }
        
        /* Shadow AI Section */
        .shadow-ai-section {
            padding: 80px 60px;
            background: #1a1a2e;
            color: white;
        }
        
        .shadow-ai-content {
            max-width: 1000px;
            margin: 0 auto;
            text-align: center;
        }
        
        .warning-icon {
            font-size: 72px;
            margin-bottom: 30px;
        }
        
        .risk-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }
        
        .risk-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 30px;
            text-align: left;
        }
        
        .risk-icon {
            font-size: 36px;
            margin-bottom: 15px;
        }
        
        .risk-title {
            font-size: 20px;
            margin-bottom: 10px;
            color: #FF6B6B;
        }
        
        /* Benefits Section */
        .benefits-section {
            padding: 80px 60px;
            background: white;
        }
        
        .benefits-container {
            display: flex;
            gap: 30px;
            overflow-x: auto;
            padding-bottom: 20px;
            margin-top: 40px;
        }
        
        .benefit-card {
            min-width: 350px;
            background: white;
            border-radius: 16px;
            border: 1px solid #e0e0e0;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        
        .benefit-header {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 30px;
            background: linear-gradient(135deg, #f8f9fb 0%, #ffffff 100%);
            border-bottom: 1px solid #e0e0e0;
        }
        
        .benefit-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #0066CC, #004499);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
        }
        
        .benefit-title {
            flex: 1;
        }
        
        .benefit-title h3 {
            font-size: 22px;
            color: #1a1a2e;
            margin-bottom: 5px;
        }
        
        .benefit-subtitle {
            font-size: 14px;
            color: #666;
            font-style: italic;
        }
        
        .benefit-list {
            list-style: none;
            padding: 30px;
        }
        
        .benefit-item {
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }
        
        .benefit-item:last-child {
            border-bottom: none;
        }
        
        /* Testimonials */
        .testimonials-section {
            padding: 80px 60px;
            background: linear-gradient(180deg, #f8f9fb 0%, #ffffff 100%);
        }
        
        .testimonial-cards {
            display: flex;
            gap: 30px;
            overflow-x: auto;
            padding-bottom: 20px;
            margin-top: 40px;
        }
        
        .testimonial-card {
            min-width: 380px;
            background: white;
            border-radius: 16px;
            padding: 30px;
            border: 1px solid #e0e0e0;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        
        .quote-mark {
            font-size: 48px;
            color: #0066CC;
            opacity: 0.2;
            position: absolute;
            top: 20px;
            left: 30px;
        }
        
        .testimonial-text {
            font-style: italic;
            color: #444;
            margin-bottom: 20px;
            margin-top: 30px;
            line-height: 1.6;
        }
        
        .testimonial-author {
            font-weight: 600;
            color: #1a1a2e;
        }
        
        .testimonial-role {
            font-size: 14px;
            color: #666;
        }
        
        /* Security Section */
        .security-section {
            padding: 80px 60px;
            background: linear-gradient(135deg, #0066CC 0%, #004499 100%);
            color: white;
        }
        
        .security-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }
        
        .security-feature {
            background: rgba(255,255,255,0.1);
            border: 2px solid rgba(255,255,255,0.2);
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .security-feature:hover {
            background: rgba(255,255,255,0.15);
            transform: translateY(-5px);
        }
        
        .security-icon {
            font-size: 48px;
            margin-bottom: 20px;
        }
        
        .security-title {
            font-size: 20px;
            margin-bottom: 10px;
        }
        
        /* ROI Section */
        .roi-section {
            padding: 80px 60px;
            background: white;
        }
        
        .roi-metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-top: 50px;
            max-width: 1000px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .roi-metric {
            text-align: center;
        }
        
        .roi-number {
            font-size: 48px;
            font-weight: 700;
            color: #0066CC;
            margin-bottom: 10px;
        }
        
        .roi-label {
            font-size: 18px;
            color: #666;
        }
        
        .timeline {
            display: flex;
            justify-content: space-between;
            margin-top: 60px;
            padding: 40px;
            background: linear-gradient(135deg, #f8f9fb 0%, #ffffff 100%);
            border-radius: 16px;
            overflow-x: auto;
        }
        
        .timeline-item {
            flex: 1;
            text-align: center;
            min-width: 200px;
        }
        
        .timeline-dot {
            width: 20px;
            height: 20px;
            background: #0066CC;
            border-radius: 50%;
            margin: 0 auto 20px;
            position: relative;
            border: 4px solid white;
            box-shadow: 0 2px 10px rgba(0,102,204,0.3);
        }
        
        .timeline-label {
            background: #0066CC;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 10px;
            display: inline-block;
        }
        
        .timeline-description {
            color: #666;
            font-size: 14px;
        }
        
        /* CTA Section */
        .cta-section {
            padding: 80px 60px;
            background: linear-gradient(135deg, #0066CC 0%, #004499 100%);
            text-align: center;
            color: white;
        }
        
        .cta-title {
            font-size: 42px;
            font-weight: 700;
            margin-bottom: 20px;
        }
        
        .cta-subtitle {
            font-size: 20px;
            margin-bottom: 40px;
            opacity: 0.95;
        }
        
        .cta-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .cta-card {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255,255,255,0.2);
            border-radius: 16px;
            padding: 30px;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .cta-card:hover {
            background: rgba(255,255,255,0.2);
            transform: translateY(-5px);
        }
        
        .cta-icon {
            font-size: 36px;
            margin-bottom: 15px;
        }
        
        .cta-action {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 10px;
        }
        
        .cta-detail {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 20px;
        }
        
        /* Footer */
        .footer {
            background: #1a1a2e;
            color: white;
            padding: 40px 60px;
            text-align: center;
        }
        
        .contact-info {
            margin-bottom: 20px;
        }
        
        .contact-info a {
            color: #00BCD4;
            text-decoration: none;
        }
        
        .footer-note {
            font-size: 12px;
            color: #888;
            margin-top: 20px;
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .header, .hero, .problem-section, .shadow-ai-section, 
            .benefits-section, .testimonials-section, .security-section,
            .roi-section, .cta-section, .footer {
                padding: 40px 20px;
            }
            
            .hero h1 {
                font-size: 32px;
            }
            
            .section-title {
                font-size: 28px;
            }
            
            .problem-card, .benefit-card, .testimonial-card {
                min-width: 300px;
            }
        }
    </style>
</head>
